+def _bs_level_means(levels: np.ndarray, y: np.ndarray, weight: np.ndarray) -> tuple[dict, float]:
+    """Buhlmann-Straub credibility mean rate per level: Z * level_mean + (1 - Z) *
+    overall_mean, Z = E / (E + sigma2 / tau2), sigma2 the exposure-weighted within-level
+    variance and tau2 the (bias-corrected) between-level variance of the level means."""
+    overall_mean = y.sum() / weight.sum()
+    level = pd.Series(levels)
+    rate = y / weight
+    e = pd.Series(weight).groupby(level).sum()
+    mean_j = pd.Series(y).groupby(level).sum() / e
+    n, j = len(level), len(e)
+    level_mean = level.map(mean_j).to_numpy()
+    sigma2 = float((weight * (rate - level_mean) ** 2).sum() / max(n - j, 1))
+    sum_e = e.sum()
+    c = sum_e - (e**2).sum() / sum_e
+    tau2 = (
+        max(((e * (mean_j - overall_mean) ** 2).sum() - (j - 1) * sigma2) / c, 0.0)
+        if c > 0
+        else 0.0
+    )
+    k = sigma2 / tau2 if tau2 > 0 else np.inf
+    z = e / (e + k)
+    cred = z * mean_j + (1 - z) * overall_mean
+    return cred.to_dict(), overall_mean
+
+
+def _bs_encode(
+    tr_col: pd.Series, va_col: pd.Series, y: np.ndarray, weight: np.ndarray
+) -> tuple[np.ndarray, np.ndarray]:
+    """Out-of-fold Buhlmann-Straub credibility encoding of one high-cardinality column
+    (backlog 2.20): exposure-weighted level means with credibility Z = E / (E + k),
+    k = within-level variance / between-level variance. The sklearn TargetEncoder this
+    replaces averages y/exposure unweighted, so short-period rows (1.6% of motor
+    exposure but 63% of the squared rate mass) set the level means and the smoothing
+    as much as a full-year row does."""
+    levels = tr_col.astype(object).fillna("__missing__").to_numpy()
+    va_levels = va_col.astype(object).fillna("__missing__").to_numpy()
+    n = len(levels)
+    fold = np.random.RandomState(SEED_OFFSET).randint(0, 5, size=n)
+    oof = np.empty(n, dtype=float)
+    for f in range(5):
+        train = fold != f
+        mapping, overall = _bs_level_means(levels[train], y[train], weight[train])
+        oof[~train] = pd.Series(levels[~train]).map(mapping).fillna(overall).to_numpy()
+    full_mapping, full_overall = _bs_level_means(levels, y, weight)
+    va_enc = pd.Series(va_levels).map(full_mapping).fillna(full_overall).to_numpy()
+    return oof, va_enc
+
+
