+def weather_factor(tr: pd.DataFrame, va: pd.DataFrame, col: str, k: float = 200.0) -> np.ndarray:
+    """Quintile-binned credibility factor (backlog E4): bin edges from the training rows
+    of this line, count-basis credibility_factors on the bin label, applied to valid."""
+    edges = np.unique(np.quantile(tr[col].dropna().to_numpy(), np.linspace(0, 1, 6)))
+    key = f"_{col}_q"
+    tr2 = tr.assign(**{key: pd.cut(tr[col], edges, include_lowest=True, duplicates="drop")})
+    va2 = va.assign(**{key: pd.cut(va[col], edges, include_lowest=True, duplicates="drop")})
+    factors = credibility_factors(tr2, key, k=k, basis="count")
+    return apply_factors(va2, key, factors)
