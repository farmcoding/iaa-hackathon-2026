+def _construction_age_band(tr: pd.DataFrame, va: pd.DataFrame) -> tuple[pd.Series, pd.Series]:
+    # backlog 2.60 / 2.47: construction_type and property_age are both already
+    # features, but the heavy regularisation (15 leaves, min_data_in_leaf 2000) may
+    # never find their interaction. diagnostics.md flags construction_type BRICK
+    # (A/E 0.930/0.803) and W (1.197/1.066) as PERSISTENT buildings misses. Bin edges
+    # come from the training quantiles, not fixed years, per the portability rule.
+    edges = np.unique(tr["property_age"].quantile([0.25, 0.5, 0.75]).to_numpy())
+    bins = np.concatenate([[-np.inf], edges, [np.inf]])
+    band_tr = pd.cut(tr["property_age"], bins=bins).astype(str)
+    band_va = pd.cut(va["property_age"], bins=bins).astype(str)
+    combo_tr = (tr["construction_type"].astype(str) + "_" + band_tr).astype("category")
+    combo_va = (va["construction_type"].astype(str) + "_" + band_va).astype("category")
+    return combo_tr, combo_va
 
 
