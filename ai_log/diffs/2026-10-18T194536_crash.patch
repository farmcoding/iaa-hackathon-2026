+def _fit_bag(
+    tr_x: pd.DataFrame,
+    va_x: pd.DataFrame,
+    target: pd.Series,
+    weight: pd.Series,
+    mono: list[int],
+    params: dict = PARAMS,
+) -> np.ndarray:
+    # seed bagging: single-seed noise (sd 0.0026 on the primary metric) is larger
+    # than most real improvements, so every model is an average over SEEDS
+    out = np.zeros(len(va_x))
+    for seed in SEEDS:
+        model = lgb.LGBMRegressor(
+            **{**params, "seed": seed},
+            monotone_constraints=mono,
+            monotone_constraints_method="advanced",
+        )
+        model.fit(tr_x, target, sample_weight=weight)
+        out += model.predict(va_x) / len(SEEDS)
+    return out
+
+
+def _calibrate(
+    tr: pd.DataFrame,
+    cols: list[str],
+    mono: list[int],
+    numerator: pd.Series,
+    weight: pd.Series,
+    raw_rate: np.ndarray,
+    params: dict = PARAMS,
+) -> np.ndarray:
+    # backlog 2.3: isotonic recalibration from an inner time-holdout (the most recent
+    # training year). An inner-train-only model's out-of-sample raw rate on the held-out
+    # year is mapped to that year's actual rate; the fitted monotone map is then applied
+    # to the full-train model's rate, to correct systematic under/over-prediction the
+    # regularized trees can't fully express.
+    years = sorted(tr["year"].unique())
+    if len(years) < 2:
+        return raw_rate
+    holdout_year = years[-1]
+    itr = tr[tr["year"] != holdout_year]
+    iho = tr[tr["year"] == holdout_year]
+    itr_x, iho_x = _credibility_encode(itr, iho, cols, itr["y"] / itr["exposure"])
+    iho_weight = weight.loc[iho.index]
+    raw_ho = _fit_bag(
+        itr_x,
+        iho_x,
+        numerator.loc[itr.index] / weight.loc[itr.index],
+        weight.loc[itr.index],
+        mono,
+        params,
+    )
+    actual_ho = (numerator.loc[iho.index] / iho_weight).to_numpy()
+    iso = IsotonicRegression(out_of_bounds="clip")
+    iso.fit(raw_ho, actual_ho, sample_weight=iho_weight.to_numpy())
+    return iso.predict(raw_rate)
+
