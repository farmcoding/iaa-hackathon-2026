+def _weather_anomaly(tr: pd.DataFrame, va: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
+    # split each weather field into the address's own climate mean (features only, no
+    # target, so no leak) plus the row's deviation from it; the mean is computed over
+    # train and valid together since valid's own weather is legitimately known.
+    cols = [c for c in WEATHER_COLS if c in tr.columns]
+    if not cols:
+        return tr, va
+    tr, va = tr.copy(), va.copy()
+    addr_mean = (
+        pd.concat([tr[["address_id", *cols]], va[["address_id", *cols]]])
+        .groupby("address_id")[cols]
+        .mean()
+    )
+    for c in cols:
+        tr_mean = tr["address_id"].map(addr_mean[c])
+        va_mean = va["address_id"].map(addr_mean[c])
+        tr[f"{c}_addr_mean"] = tr_mean
+        va[f"{c}_addr_mean"] = va_mean
+        tr[c] = tr[c] - tr_mean
+        va[c] = va[c] - va_mean
+    return tr, va
+
+
