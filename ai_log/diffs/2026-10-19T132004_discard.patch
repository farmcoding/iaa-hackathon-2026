+def _null_importance_cols(
+    tr_x: pd.DataFrame, cols: list[str], target: pd.Series, weight: pd.Series, seed: int
+) -> list[str]:
+    # backlog 2.8: a feature whose real split-gain importance is no better than the
+    # same feature's importance against a shuffled target is noise. Cheap probe models
+    # (300 rounds, not the full 1200) just rank features; MONOTONE columns are owner
+    # decisions and are always kept regardless of this check.
+    probe = {**PARAMS, "n_estimators": 300, "seed": seed}
+    real = lgb.LGBMRegressor(**probe).fit(tr_x, target, sample_weight=weight)
+    rng = np.random.default_rng(seed)
+    shuffled = pd.Series(rng.permutation(target.to_numpy()), index=target.index)
+    null = lgb.LGBMRegressor(**probe).fit(tr_x, shuffled, sample_weight=weight)
+    keep = [
+        c
+        for c, r, n in zip(cols, real.feature_importances_, null.feature_importances_)
+        if c in MONOTONE or r > n
+    ]
+    return keep or cols
+
