+def _bs_table(level: np.ndarray, rate: np.ndarray, weight: np.ndarray) -> tuple[pd.Series, float]:
+    # Buhlmann-Straub credibility per level: Z = E / (E + k), k = within-level rate
+    # variance / between-level rate variance, so thinly-exposed levels shrink hard
+    # toward the mean instead of contributing their own noisy mean untouched.
+    df = pd.DataFrame({"lvl": level, "rate": rate, "w": weight})
+    global_mean = np.average(df["rate"], weights=df["w"])
+    grp = df.groupby("lvl", sort=False)
+    level_w = grp["w"].sum()
+    level_mean = df.assign(wr=df["w"] * df["rate"]).groupby("lvl", sort=False)["wr"].sum() / level_w
+    resid2 = df["w"] * (df["rate"] - level_mean.reindex(df["lvl"]).to_numpy()) ** 2
+    within_var = resid2.sum() / max(len(df) - len(level_w), 1)
+    between_var = max(np.average((level_mean - global_mean) ** 2, weights=level_w), 1e-6)
+    k = within_var / between_var
+    z = level_w / (level_w + k)
+    return z * level_mean + (1 - z) * global_mean, global_mean
+
