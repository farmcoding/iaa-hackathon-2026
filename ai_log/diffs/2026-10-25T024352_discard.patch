+USE_GLM_CORRECTION = True
+GLM_ALPHA = 10.0
+GLM_FEATURES = {
+    "motor": ["region", "driver_age_band", "new_business", "channel", "cover_type"],
+    "buildings": ["region", "policyholder_age_band", "new_business", "channel"],
+    "contents": ["region", "policyholder_age_band", "new_business", "channel"],
+}
+
+
+def _glm_design(df: pd.DataFrame, line: str, columns: pd.Index | None = None) -> pd.DataFrame:
+    cat = df[GLM_FEATURES[line]].astype("string").fillna("missing")
+    dummies = pd.get_dummies(cat)
+    if columns is not None:
+        dummies = dummies.reindex(columns=columns, fill_value=0)
+    return dummies
+
+
+def glm_ratio(
+    tr: pd.DataFrame, va: pd.DataFrame, line: str, base_tr: np.ndarray, alpha: float
+) -> np.ndarray:
+    """Ridge log-link Tweedie correction ratio to a base prediction (`base_tr` on the
+    training rows): fits y / base_tr jointly on a handful of shifted factors, weight
+    base_tr ** 0.5, alpha penalising every coefficient towards 0 (ratio towards 1, i.e.
+    no change). Returns the predicted ratio for `va`; multiply by the matching valid-row
+    base to get the corrected prediction."""
+    x_tr = _glm_design(tr, line)
+    x_va = _glm_design(va, line, columns=x_tr.columns)
+    target = tr["y"].to_numpy() / np.maximum(base_tr, 1e-6)
+    weight = np.maximum(base_tr, 1e-6) ** 0.5
+    model = TweedieRegressor(power=1.5, link="log", alpha=alpha, max_iter=1000)
+    model.fit(x_tr, target, sample_weight=weight)
+    return model.predict(x_va)
 
 
