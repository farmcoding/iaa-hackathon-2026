 def _feature_cols(df: pd.DataFrame, line: str) -> list[str]:
@@ -119,6 +125,15 @@ def _fit_line(tr: pd.DataFrame, va: pd.DataFrame) -> np.ndarray:
     return out / len(SEEDS)
 
 
+def _region_factor(tr: pd.DataFrame) -> pd.Series:
+    """Credibility-weighted A/E factor per region, shrunk towards 1 (no correction)."""
+    g = tr.groupby("region", observed=True)
+    n_claims = g["y"].apply(lambda s: (s > 0).sum())
+    ae = g["y"].sum() / g["base"].sum().clip(lower=1e-6)
+    z = n_claims / (n_claims + REGION_K)
+    return 1 + z * (ae - 1)
+
+
