+        interactions=0,
+        smoothing_rounds=2000,
+        min_samples_leaf=1000,
+        objective="tweedie_deviance:variance_power=1.5",
+        random_state=0,
+    )
+    m.fit(tr[cols], tr["y"].to_numpy(), init_score=off_tr)
+    return m.predict(va[cols], init_score=off_va)
 
 
