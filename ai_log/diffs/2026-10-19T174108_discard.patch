+from iaa import data
+from iaa.features import _window_counts
+
+# backlog 2.45, same-line-only half of "test each": hist_n_customer/hist_cost_customer
+# (features.py) pool a customer's prior claims across all three lines. Features review
+# 1.2 found that for buildings and contents, 64-67% of rows where that history fires
+# carry a claim from the customer's OTHER line, not the one being priced; pooled, the
+# signal was weak enough that pruning dropped it (model_card.json). This replaces the
+# pooled columns with a same-line-only count and cost, built from claims' own `line`
+# field directly (no merge-induced column collision, unlike the crashed cross-line
+# variant in ai_log/diffs/2026-10-19T100139_crash.patch).
+PROPERTY_LINES = ("buildings", "contents")
+HIST_COLS = ("hist_n_customer", "hist_cost_customer")
+
+
+@lru_cache(maxsize=3)
+def _same_line_claims(line: str) -> pd.DataFrame:
+    c = data.claims()
+    c = c[(c["status"] != "repudiated") & (c["line"] == line)]
+    pol = data.all_policies("train")[["policy_id", "customer_id"]].drop_duplicates("policy_id")
+    return c.merge(pol, on="policy_id", how="left").dropna(subset=["customer_id"])
+
+
+def _same_line_history(rows: pd.DataFrame, line: str) -> tuple[np.ndarray, np.ndarray]:
+    same = _same_line_claims(line)
+    n, s = _window_counts(
+        rows["customer_id"],
+        rows["period_start"],
+        same["customer_id"],
+        same["report_date"],
+        same["net"].to_numpy(),
+    )
+    # features.py blanks hist_n_customer/hist_cost_customer for rows without a full
+    # 365-day look-back (period_start before 2022-01-01); match that here.
+    full = (rows["period_start"] >= pd.Timestamp("2022-01-01")).to_numpy()
+    return np.where(full, n, np.nan), np.where(full, s, np.nan)
+
+
