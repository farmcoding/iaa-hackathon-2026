+# backlog 2.45: hist_n_customer/hist_cost_customer (features.py) pool a customer's prior
+# claims across all three lines. Features review 1.2 found that for buildings and contents,
+# 64-67% of rows where that history fires are carrying a claim from the customer's OTHER
+# line, not the line being priced. Split the pooled figure into a same-line component (new
+# model input) and a cross-line remainder (pooled minus same-line), so each can earn its own
+# relativity instead of one blended one. First attempt (results.tsv `cf6ca18`) crashed:
+# `data.claims()` already carries a native `line` column, and merging policy->line onto it
+# by `policy_id` alone collided into `line_x`/`line_y`. Fixed by filtering on claims' own
+# `line` before merging in just `customer_id`, so no column name collides.
+@lru_cache(maxsize=3)
+def _same_line_claims(line: str) -> pd.DataFrame:
+    c = data.claims()
+    c = c[(c["status"] != "repudiated") & (c["line"] == line)]
+    pol = data.all_policies("train")[["policy_id", "customer_id"]].drop_duplicates("policy_id")
+    return c.merge(pol, on="policy_id", how="left").dropna(subset=["customer_id"])
+
+
+def _same_line_history(rows: pd.DataFrame, line: str) -> tuple[np.ndarray, np.ndarray]:
+    same = _same_line_claims(line)
+    n, s = _window_counts(
+        rows["customer_id"],
+        rows["period_start"],
+        same["customer_id"],
+        same["report_date"],
+        same["net"].to_numpy(),
+    )
+    # features.py blanks hist_n_customer/hist_cost_customer for rows without a full
+    # 365-day look-back (period_start before 2022-01-01); match that here so the new
+    # same-line component, and the cross-line remainder, carry the same "unknown" convention.
+    full = (rows["period_start"] >= pd.Timestamp("2022-01-01")).to_numpy()
+    return np.where(full, n, np.nan), np.where(full, s, np.nan)
+
