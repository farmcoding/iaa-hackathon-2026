+def glm_ratio(
+    tr: pd.DataFrame, va: pd.DataFrame, line: str, base_tr: np.ndarray, alpha: float
+) -> np.ndarray:
+    """Ridge log-link Tweedie correction ratio to a base prediction (`base_tr` on the
+    training rows): fits y / base_tr jointly on a handful of shifted categorical factors
+    (one-hot) plus standardised weather numerics (mean/std from training only), weight
+    base_tr ** 0.5, alpha penalising every coefficient towards 0 (ratio towards 1, i.e. no
+    change). Returns the predicted ratio for `va`; multiply by the matching valid-row base
+    to get the corrected prediction."""
+    cat_tr = tr[GLM_FEATURES[line]].astype("string").fillna("missing")
+    x_tr = pd.get_dummies(cat_tr).reset_index(drop=True)
+    cat_va = va[GLM_FEATURES[line]].astype("string").fillna("missing")
+    x_va = pd.get_dummies(cat_va).reindex(columns=x_tr.columns, fill_value=0).reset_index(drop=True)
+    num_cols = GLM_NUMERIC.get(line, [])
+    if num_cols:
+        num_tr = tr[num_cols].astype(float).reset_index(drop=True)
+        mean, std = num_tr.mean(), num_tr.std().replace(0, 1.0)
+        x_tr = pd.concat([x_tr, (num_tr - mean) / std], axis=1)
+        num_va = va[num_cols].astype(float).reset_index(drop=True)
+        x_va = pd.concat([x_va, (num_va - mean) / std], axis=1)
+    target = tr["y"].to_numpy() / np.maximum(base_tr, 1e-6)
+    weight = np.maximum(base_tr, 1e-6) ** 0.5
+    model = TweedieRegressor(power=1.5, link="log", alpha=alpha, max_iter=1000)
+    model.fit(x_tr, target, sample_weight=weight)
+    return model.predict(x_va)
 
 
