+def _calibrate(
+    tr: pd.DataFrame,
+    cols: list[str],
+    mono: list[int],
+    numerator: pd.Series,
+    weight: pd.Series,
+    raw_rate: np.ndarray,
+    params: dict = PARAMS,
+) -> np.ndarray:
+    # Tier 0c.4 / backlog 2.3: a plain LightGBM bag fit on all training years but the
+    # last, scored out-of-sample on that last year, gives a raw-rate -> actual-rate
+    # curve; isotonic regression on that curve corrects systematic under/over-prediction
+    # the regularised trees leave on the table, then applies to the full blended rate.
+    years = sorted(tr["year"].unique())
+    if len(years) < 2:
+        return raw_rate
+    holdout_year = years[-1]
+    itr, iho = tr[tr["year"] != holdout_year], tr[tr["year"] == holdout_year]
+    itr_x, iho_x = _credibility_encode(itr, iho, cols, itr["y"] / itr["exposure"])
+    itr_w, iho_w = weight.loc[itr.index], weight.loc[iho.index]
+    itr_target = numerator.loc[itr.index] / itr_w
+    out = np.zeros(len(iho))
+    for seed in SEEDS:
+        model = lgb.LGBMRegressor(
+            **{**params, "seed": seed},
+            monotone_constraints=mono,
+            monotone_constraints_method="advanced",
+        )
+        model.fit(itr_x, itr_target, sample_weight=itr_w)
+        out += model.predict(iho_x) / len(SEEDS)
+    actual_ho = (numerator.loc[iho.index] / iho_w).to_numpy()
+    iso = IsotonicRegression(out_of_bounds="clip")
+    iso.fit(out, actual_ho, sample_weight=iho_w.to_numpy())
+    return iso.predict(raw_rate)
+
