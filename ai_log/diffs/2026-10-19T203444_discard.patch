+# backlog 2.73: a spline GLM as a diversity blend member for motor's non-BI perils (a
+# light bake-off found a GLM the best single technique on motor, +0.0075 within-line vs
+# LightGBM). The one prior GLM-blend attempt on property (results.tsv `760ab72`,
+# `8eb2031`) broke because it one-hot-encoded train and valid separately with
+# `pd.get_dummies`, so the two frames could get different dummy columns and the fitted
+# coefficients lined up with the wrong columns at predict time. Fitting one
+# ColumnTransformer on train only and calling `.transform` (not `.fit_transform`) on
+# valid guarantees the same columns in the same order on both sides.
+def _motor_glm_rate(
+    tr_x: pd.DataFrame, va_x: pd.DataFrame, target: pd.Series, weight: pd.Series
+) -> np.ndarray:
+    num_cols = [c for c in tr_x.columns if not isinstance(tr_x[c].dtype, pd.CategoricalDtype)]
+    cat_cols = [c for c in tr_x.columns if c not in num_cols]
+    tr_d = pd.concat([tr_x[num_cols], _ebm_safe(tr_x[cat_cols])], axis=1)
+    va_d = pd.concat([va_x[num_cols], _ebm_safe(va_x[cat_cols])], axis=1)
+    pre = ColumnTransformer(
+        [
+            (
+                "num",
+                Pipeline(
+                    [
+                        ("impute", SimpleImputer(strategy="median")),
+                        # constant extrapolation bounds the design for out-of-range
+                        # valid rows instead of letting the spline basis blow up
+                        ("spline", SplineTransformer(n_knots=5, degree=3, include_bias=False)),
+                    ]
+                ),
+                num_cols,
+            ),
+            ("cat", OneHotEncoder(handle_unknown="ignore"), cat_cols),
+        ]
+    )
+    model = Pipeline(
+        [
+            ("pre", pre),
+            (
+                "glm",
+                TweedieRegressor(
+                    power=PARAMS["tweedie_variance_power"],
+                    link="log",
+                    solver="newton-cholesky",
+                    max_iter=300,
+                ),
+            ),
+        ]
+    )
+    model.fit(tr_d, target, glm__sample_weight=weight)
+    return model.predict(va_d)
+
