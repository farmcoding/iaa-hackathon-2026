+def _fit_bag(
+    tr_x: pd.DataFrame,
+    va_x: pd.DataFrame,
+    target: pd.Series,
+    weight: pd.Series,
+    mono: list[int],
+    params: dict = PARAMS,
+) -> np.ndarray:
+    # seed bagging: single-seed noise (sd 0.0026 on the primary metric) is larger
+    # than most real improvements, so every model is an average over SEEDS
+    out = np.zeros(len(va_x))
+    for seed in SEEDS:
+        model = lgb.LGBMRegressor(
+            **{**params, "seed": seed},
+            monotone_constraints=mono,
+            monotone_constraints_method="advanced",
+        )
+        model.fit(tr_x, target, sample_weight=weight)
+        out += model.predict(va_x) / len(SEEDS)
+    return out
+
+
+def _calibrate(
+    tr: pd.DataFrame,
+    cols: list[str],
+    numerator: pd.Series,
+    weight: pd.Series,
+    raw_rate: np.ndarray,
+    predict_fn,
+) -> np.ndarray:
+    # backlog 2.3 / Tier 0c.4: an inner-train-only model's out-of-sample rate on the most
+    # recent training year, isotonically mapped to that year's actual rate, corrects
+    # systematic under/over-prediction the regularised trees can't fully express. Skipped
+    # for motor's BI model (poisson counts, not a Tweedie sub-rate) per the backlog item.
+    years = sorted(tr["year"].unique())
+    if len(years) < 2:
+        return raw_rate
+    holdout_year = years[-1]
+    itr, iho = tr[tr["year"] != holdout_year], tr[tr["year"] == holdout_year]
+    itr_x, iho_x = _credibility_encode(itr, iho, cols, itr["y"] / itr["exposure"])
+    inum, iwt = numerator.loc[itr.index], weight.loc[itr.index]
+    raw_ho = predict_fn(itr_x, iho_x, inum, iwt)
+    actual_ho = (numerator.loc[iho.index] / weight.loc[iho.index]).to_numpy()
+    iso = IsotonicRegression(out_of_bounds="clip")
+    iso.fit(raw_ho, actual_ho, sample_weight=weight.loc[iho.index].to_numpy())
+    return iso.predict(raw_rate)
+
