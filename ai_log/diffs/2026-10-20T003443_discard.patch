     return x
 
 
+# motor BI frequency has only ever been a single LightGBM Poisson bag. EBM as a second
+# learner on BI (results.tsv `c6b02cf`) scored below champion, but a spline GLM was the
+# best single technique on motor overall in the interactions bake-off, and it has only
+# been tried on motor's "other" (cost) sub-model, never on BI frequency. Column handling
+# copied from the saved GLM-on-"other" diff (ai_log/diffs/2026-10-20T000814_discard.patch):
+# fit one ColumnTransformer on train only and `.transform` (not `.fit_transform`) on
+# valid, since the earlier property GLM blend (results.tsv `760ab72`) broke by one-hot
+# encoding train and valid separately.
+def _motor_glm_rate(
+    tr_x: pd.DataFrame, va_x: pd.DataFrame, target: pd.Series, weight: pd.Series
+) -> np.ndarray:
+    num_cols = [c for c in tr_x.columns if not isinstance(tr_x[c].dtype, pd.CategoricalDtype)]
+    cat_cols = [c for c in tr_x.columns if c not in num_cols]
+    tr_d = pd.concat([tr_x[num_cols], _ebm_safe(tr_x[cat_cols])], axis=1)
+    va_d = pd.concat([va_x[num_cols], _ebm_safe(va_x[cat_cols])], axis=1)
+    pre = ColumnTransformer(
+        [
+            (
+                "num",
+                Pipeline(
+                    [
+                        ("impute", SimpleImputer(strategy="median")),
+                        ("spline", SplineTransformer(n_knots=5, degree=3, include_bias=False)),
+                    ]
+                ),
+                num_cols,
+            ),
+            ("cat", OneHotEncoder(handle_unknown="ignore"), cat_cols),
+        ]
+    )
+    model = Pipeline(
+        [("pre", pre), ("glm", PoissonRegressor(solver="newton-cholesky", max_iter=300))]
+    )
+    model.fit(tr_d, target, glm__sample_weight=weight)
+    return model.predict(va_d)
+
