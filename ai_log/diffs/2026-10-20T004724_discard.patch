+# backlog 2.61: raw hist_cost_customer/hist_cost_policy are pruned on buildings and
+# contents. model_card.json (the pre-pruning model, pooled over all three lines) shows
+# hist_cost_policy's own shuffle d2_drop at -0.00042 on buildings -- shuffling it helps,
+# i.e. a few large historical claims are adding noise relative to the credibility they
+# carry -- while buildings keeps the count companions (hist_n_customer, hist_n_policy)
+# as live features. Capping before use, restored only on buildings and contents (never
+# on motor, which already has its own large-loss treatment via BI_CAP/_bi_level).
+HIST_COST_CAP_Q = 0.9
+
+
+def _capped_history(
+    tr: pd.DataFrame, va: pd.DataFrame, cols: tuple[str, ...]
+) -> tuple[pd.DataFrame, pd.DataFrame]:
+    tr, va = tr.copy(), va.copy()
+    for col in cols:
+        pos = tr[col][tr[col] > 0]
+        cap = pos.quantile(HIST_COST_CAP_Q) if len(pos) >= 20 else np.inf
+        tr[f"{col}_capped"] = tr[col].clip(upper=cap)
+        va[f"{col}_capped"] = va[col].clip(upper=cap)
+    return tr, va
+
